    {
      "name": "05 - Lifecycle and reconnect",
      "item": [
        {
          "name": "Start game",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{teacherToken}}" }
            ],
            "url": "{{baseUrl}}{{apiPrefix}}/game-sessions/{{sessionId}}/start"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('PLAYING', () => pm.expect(json.data.status).to.eql('PLAYING'));",
                  "pm.collectionVariables.set('stateVersion', String(json.data.stateVersion));"
                ]
              }
            }
          ]
        },
        {
          "name": "Pause game",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{teacherToken}}" }
            ],
            "url": "{{baseUrl}}{{apiPrefix}}/game-sessions/{{sessionId}}/pause"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('PAUSED', () => pm.expect(json.data.status).to.eql('PAUSED'));",
                  "pm.collectionVariables.set('stateVersion', String(json.data.stateVersion));"
                ]
              }
            }
          ]
        },
        {
          "name": "Resume game",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{teacherToken}}" }
            ],
            "url": "{{baseUrl}}{{apiPrefix}}/game-sessions/{{sessionId}}/resume"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('PLAYING', () => pm.expect(json.data.status).to.eql('PLAYING'));",
                  "pm.collectionVariables.set('stateVersion', String(json.data.stateVersion));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reconnect student A with same UUID",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionId\": \"{{participantA}}\",\n  \"fullName\": \"Siswa A\"\n}"
            },
            "url": "{{baseUrl}}{{apiPrefix}}/public/game-sessions/{{sessionId}}/participants"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('HTTP 201 or 200', () => pm.expect([200, 201]).to.include(pm.response.code));",
                  "pm.test('same UUID restored', () => pm.expect(json.data.sessionId).to.eql(pm.collectionVariables.get('participantA')));",
                  "pm.test('CONNECTED', () => pm.expect(json.data.status).to.eql('CONNECTED')); "
                ]
              }
            }
          ]
        },
        {
          "name": "Get student state after reconnect",
          "request": {
            "method": "GET",
            "header": [
              { "key": "x-participant-session-id", "value": "{{participantA}}" }
            ],
            "url": "{{baseUrl}}{{apiPrefix}}/public/game-sessions/{{sessionId}}/state"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('state is PLAYING', () => pm.expect(json.data.status).to.eql('PLAYING'));",
                  "pm.test('participant restored', () => pm.expect(json.data.participant).to.exist);"
                ]
              }
            }
          ]
        },
        {
          "name": "Finish game",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{teacherToken}}" }
            ],
            "url": "{{baseUrl}}{{apiPrefix}}/game-sessions/{{sessionId}}/finish"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('FINISHED', () => pm.expect(json.data.status).to.eql('FINISHED')); "
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "06 - Negative checks",
      "item": [
        {
          "name": "Wrong password returns 401",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
