  "item": [
    {
      "name": "00 - Super Admin",
      "item": [
        {
          "name": "Super Admin login - saves superAdminToken",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{superAdminEmail}}\",\n  \"password\": \"{{superAdminPassword}}\"\n}"
            },
            "url": "{{baseUrl}}{{apiPrefix}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('super admin role', () => pm.expect(json.data.user.role).to.eql('SUPER_ADMIN'));",
                  "pm.collectionVariables.set('superAdminToken', json.data.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Super Admin dashboard",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{superAdminToken}}" }
            ],
            "url": "{{baseUrl}}{{apiPrefix}}/super-admin/dashboard"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('dashboard data exists', () => pm.expect(pm.response.json().data).to.exist);"
                ]
              }
            }
          ]
        },
        {
          "name": "List schools",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{superAdminToken}}" }
            ],
            "url": "{{baseUrl}}{{apiPrefix}}/schools"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('school list exists', () => pm.expect(json.data.items).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create school - saves schoolId and admin credential",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{superAdminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"MindPlay QA {{schoolSuffix}}\",\n  \"domain\": \"mindplayqa{{schoolSuffix}}.school.id\"\n}"
            },
            "url": "{{baseUrl}}{{apiPrefix}}/schools"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('schoolSuffix', String(Date.now()));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "pm.expect(json.data.school.id).to.exist;",
                  "pm.collectionVariables.set('schoolId', String(json.data.school.id));",
                  "pm.collectionVariables.set('createdAdminEmail', json.data.admin.email);",
                  "pm.collectionVariables.set('createdAdminPassword', json.data.admin.password);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get school detail",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{superAdminToken}}" }
            ],
            "url": "{{baseUrl}}{{apiPrefix}}/schools/{{schoolId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('school id matches', () => pm.expect(String(pm.response.json().data.id)).to.eql(pm.collectionVariables.get('schoolId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Set school status active",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{superAdminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"ACTIVE\"\n}" },
            "url": "{{baseUrl}}{{apiPrefix}}/schools/{{schoolId}}/status"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reset school admin password",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{superAdminToken}}" }
            ],
            "url": "{{baseUrl}}{{apiPrefix}}/schools/{{schoolId}}/admin/reset-password"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.expect(json.data.email).to.be.a('string');",
                  "pm.expect(json.data.password).to.be.a('string');"
                ]
              }
            }
          ]
        }
      ]
    },
