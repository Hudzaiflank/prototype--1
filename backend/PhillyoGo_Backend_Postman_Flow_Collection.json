        {
          "name": "Teacher login - saves teacherToken",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{teacherEmail}}\",\n  \"password\": \"{{teacherPassword}}\"\n}"
            },
            "url": "{{baseUrl}}{{apiPrefix}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('teacher role', () => pm.expect(json.data.user.role).to.eql('TEACHER'));",
                  "pm.collectionVariables.set('teacherToken', json.data.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Open room - saves roomId and roomCode",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{teacherToken}}" }
            ],
            "url": "{{baseUrl}}{{apiPrefix}}/classes/{{classId}}/rooms"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "pm.expect(json.data.code).to.match(/^[A-Z0-9]{6}$/);",
                  "pm.collectionVariables.set('roomId', String(json.data.id));",
                  "pm.collectionVariables.set('roomCode', json.data.code);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create game session - saves sessionId",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{teacherToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"inputMode\": \"STUDENT\",\n  \"gameMode\": \"GROUPS\",\n  \"problemDisplayLimit\": 1,\n  \"groupCount\": 2\n}"
            },
            "url": "{{baseUrl}}{{apiPrefix}}/rooms/{{roomId}}/game-sessions"
          },
          "event": [
