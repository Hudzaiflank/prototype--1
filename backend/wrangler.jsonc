{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "phillyogo-api",
  "main": "worker/index.js",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["0 2 * * *"]
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "REPLACE_WITH_HYPERDRIVE_CONFIG_ID"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_REALTIME",
        "class_name": "GameRealtime"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameRealtime"]
    }
  ],
  "vars": {
    "NODE_ENV": "production",
    "FRONTEND_URLS": "https://prototype--1.pages.dev"
  }
}
