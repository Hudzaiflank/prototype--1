        <mxCell id="title" value="PhillyoGo - Current Database ERD (MySQL 8)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="600" height="40" as="geometry" /></mxCell>
        <mxCell id="legend" value="PK = primary key | FK = foreign key | UK = unique | generated = generated column" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="60" width="700" height="30" as="geometry" /></mxCell>
        <mxCell id="schools" value="&lt;b&gt;SCHOOLS&lt;/b&gt;&lt;hr&gt;PK id BIGINT&lt;br&gt;name VARCHAR(150)&lt;br&gt;level ENUM&lt;br&gt;UK slug VARCHAR(180)&lt;br&gt;UK domain VARCHAR(150) NULL&lt;br&gt;status ENUM&lt;br&gt;created_at, updated_at" style="shape=swimlane;html=1;rounded=0;startSize=32;horizontal=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#333333;fontSize=12;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="250" height="190" as="geometry" /></mxCell>
        <mxCell id="users" value="&lt;b&gt;USERS&lt;/b&gt;&lt;hr&gt;PK id BIGINT&lt;br&gt;FK school_id BIGINT NULL&lt;br&gt;role ENUM&lt;br&gt;full_name, NIP CHAR(18) UK&lt;br&gt;email UK&lt;br&gt;password_hash&lt;br&gt;status ENUM&lt;br&gt;admin_school_id UK generated&lt;br&gt;last_login_at, timestamps" style="shape=swimlane;html=1;rounded=0;startSize=32;horizontal=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#333333;fontSize=12;align=left;" vertex="1" parent="1"><mxGeometry x="340" y="130" width="270" height="210" as="geometry" /></mxCell>
        <mxCell id="classes" value="&lt;b&gt;CLASSES&lt;/b&gt;&lt;hr&gt;PK id BIGINT&lt;br&gt;FK school_id BIGINT&lt;br&gt;academic_year VARCHAR(9)&lt;br&gt;grade_level, major&lt;br&gt;class_number, name&lt;br&gt;status ENUM&lt;br&gt;UK school/year/grade/major/number" style="shape=swimlane;html=1;rounded=0;startSize=32;horizontal=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#333333;fontSize=12;align=left;" vertex="1" parent="1"><mxGeometry x="660" y="130" width="270" height="190" as="geometry" /></mxCell>
        <mxCell id="teachers" value="&lt;b&gt;TEACHER_CLASSES&lt;/b&gt;&lt;hr&gt;PK id BIGINT&lt;br&gt;FK teacher_id -&gt; users&lt;br&gt;FK class_id -&gt; classes&lt;br&gt;assigned_at, unassigned_at&lt;br&gt;UK teacher_id/class_id" style="shape=swimlane;html=1;rounded=0;startSize=32;horizontal=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#333333;fontSize=12;align=left;" vertex="1" parent="1"><mxGeometry x="980" y="130" width="270" height="160" as="geometry" /></mxCell>
